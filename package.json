{
  "name": "jetpack-multiplayer",
  "version": "1.0.0",
  "description": "Jetpack - Retro Arcade Action with Real-time Multiplayer Engine",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "vite",
    "prebuild": "tsx scripts/generate_version.ts",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && az webapp up --resource-group jetpack-rg",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test_shared.ts && tsx scripts/test_server.ts && tsx scripts/test_phase5.ts && tsx scripts/test_list_rooms.ts && tsx scripts/test_server_regressions.ts && tsx scripts/test_compete_delay.ts && tsx scripts/test_compete_exit.ts && tsx scripts/test_extralife.ts",
    "test:shared": "tsx scripts/test_shared.ts",
    "test:server": "tsx scripts/test_server.ts",
    "test:phase5": "tsx scripts/test_phase5.ts",
    "test:list_rooms": "tsx scripts/test_list_rooms.ts",
    "test:server-regressions": "tsx scripts/test_server_regressions.ts",
    "test:compete-delay": "tsx scripts/test_compete_delay.ts",
    "test:compete-exit": "tsx scripts/test_compete_exit.ts",
    "test:extralife": "tsx scripts/test_extralife.ts"
  },
  "keywords": [
    "jetpack",
    "multiplayer",
    "canvas",
    "arcade"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/socket.io": "^3.0.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
